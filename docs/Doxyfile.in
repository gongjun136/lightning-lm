PROJECT_NAME           = "Lightning-LM"
PROJECT_BRIEF          = "开发与算法手册：运行流程、核心原理、API 与源码"
OUTPUT_DIRECTORY       = "@DOXYGEN_OUTPUT_DIRECTORY@"
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = Chinese

INPUT                  = "@LIGHTNING_SOURCE_DIR@/docs" \
                         "@LIGHTNING_SOURCE_DIR@/src"
FILE_PATTERNS          = *.md *.dox *.h *.hpp *.cc *.cpp
RECURSIVE              = YES
EXCLUDE                = "@LIGHTNING_SOURCE_DIR@/src/core/miao/examples"
USE_MDFILE_AS_MAINPAGE = "@LIGHTNING_SOURCE_DIR@/docs/index.md"
# Shell files are shown verbatim as examples; Doxygen does not parse Bash symbols.
EXAMPLE_PATH           = "@LIGHTNING_SOURCE_DIR@/scripts"
EXAMPLE_PATTERNS       = *.sh
EXAMPLE_RECURSIVE      = YES
LAYOUT_FILE            = "@LIGHTNING_SOURCE_DIR@/docs/DoxygenLayout.xml"

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
LOOKUP_CACHE_SIZE      = 2
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = "@LIGHTNING_SOURCE_DIR@"
STRIP_FROM_INC_PATH    = "@LIGHTNING_SOURCE_DIR@/src"

MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 4
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html
HTML_DYNAMIC_MENUS     = YES
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
# API 页面和源码浏览器已经提供文档 → 符号 → 定义跳转。全仓库双向
# “谁引用谁”列表计算代价很高，且会淹没手写的数据流说明，因此不生成。
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO

HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
COLLABORATION_GRAPH    = YES
DIRECTORY_GRAPH        = YES
DOT_GRAPH_MAX_NODES    = 80
MAX_DOT_GRAPH_DEPTH    = 3
USE_MATHJAX            = YES
MATHJAX_EXTENSIONS     = TeX/AMSmath TeX/AMSsymbols

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
WARN_LOGFILE           = "@CMAKE_CURRENT_BINARY_DIR@/doxygen-warnings.log"
